# ==============================================================================
# MedBalance-Q Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Core Infrastructure
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://medbal:medbal_secret_pw@postgres:5432/medbal
REDIS_URL=redis://redis:6379/0
MQTT_URL=mqtt://mosquitto:1883

# Execution & Simulation
# DEMO_MODE: live | record | replay
DEMO_MODE=live
USE_FIXTURES=0
# Simulation anchor date (used by medbal_common.clock when sim-control is offline)
SIM_START_DATE=2026-11-01T08:00:00+05:30

# Inter-Service URLs
SIM_CONTROL_URL=http://sim-control:8100
CORE_API_URL=http://core-api:8001
INGEST_AI_URL=http://ingest-ai:8002
GENAI_URL=http://genai:8003
FORECAST_URL=http://forecast:8004
OPTIMIZER_URL=http://optimizer:8005
COLDCHAIN_URL=http://coldchain:8006
SIM_HOSPITAL_H1_URL=http://sim-hospital-h1:8101
SIM_HOSPITAL_H2_URL=http://sim-hospital-h2:8102
SIM_HOSPITAL_H3_URL=http://sim-hospital-h3:8103
SIM_HOSPITAL_H4_URL=http://sim-hospital-h4:8104

# LLM Configuration (CLAUDE.md §8)
# All LLM calls route through genai POST /llm/complete
LLM_MODEL_FAST=claude-3-5-haiku-20241022
LLM_MODEL_SMART=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# QpiAI Quantum & Opt Configuration (CLAUDE.md §7)
# Used for QAOA Max-Cut zoning and QUBO allocation
QPIAI_API_KEY=your_qpiai_api_key_here
QPIAI_ENDPOINT=https://api.qpiai.tech

# Nginx Gateway Port
GATEWAY_PORT=8080
